+
+// The Version 1 part trigger: it watched `data` and had no instr() prefilter. Compact layout only, so the reindex body is
+// inlined here instead of imported (the real one is not exported).
+const VersionOnePartUpdate = `AFTER UPDATE OF type, data, ordinal ON session_part WHEN (NEW.type = 'text' OR OLD.type = 'text') AND EXISTS (SELECT 1 FROM session_message AS m WHERE m.id = NEW.message_id AND m.type = 'assistant' AND json_valid(m.data) AND json_extract(m.data, '$.time.completed') IS NOT NULL) BEGIN
+  DELETE FROM session_search WHERE rowid = (SELECT id FROM session_search_document WHERE source_id = NEW.message_id);
+  DELETE FROM session_search_document WHERE source_id = NEW.message_id;
+  INSERT INTO session_search_document (source_id, session_id) VALUES (NEW.message_id, NEW.session_id);
+  INSERT INTO session_search (rowid, title, summary, user_text, assistant_text)
+    SELECT document.id, source.title, source.summary, source.user_text, source.assistant_text
+    FROM session_search_source AS source, session_search_document AS document
+    WHERE source.source_id = NEW.message_id AND document.source_id = NEW.message_id;
+END`
+
+const swapPartTrigger = (db: Db) =>
+  Effect.gen(function* () {
+    yield* db.run("DROP TRIGGER session_search_part_update")
+    yield* db.run(`CREATE TRIGGER session_search_part_update ${VersionOnePartUpdate}`)
+  })
+
+const Queries = ["indexing", "delta", "gamma", "edited", "parsing", "question", "alpha1", "bravo", "renamed", "streaming", "words"]
+const hits = (db: Db) => Effect.forEach(Queries, (query) => find(db, query))
+
+const addPart = (db: Db, message: string, session: SessionID, content: SessionMessage.AssistantContent) =>
+  db
+    .insert(SessionPartTable)
+    .values({
+      message_id: id(message),
+      session_id: session,
+      ordinal: 0,
+      type: "text",
+      call_id: null,
+      time_created: 1,
+      time_updated: 1,
+      data: encodePart(content),
+    })
+    .run()
+
+/** A raw part edit, as the streaming and legacy paths make it; `reindex` is what production calls after a post-completion one. */
+const editPart = (db: Db, message: string, value: string, reindex: boolean) =>
+  Effect.gen(function* () {
+    yield* db
+      .update(SessionPartTable)
+      .set({ data: encodePart(text(value)) })
+      .where(and(eq(SessionPartTable.message_id, id(message)), eq(SessionPartTable.ordinal, 0)))
+      .run()
+    if (reindex) yield* SessionSearchIndex.reindexPart(db, id(message))
+  })
+
+/** Streams, completes and edits assistant messages in 50 sessions, then deletes some messages and sessions. */
+const seedA = (db: Db, reindex: boolean) =>
+  Effect.gen(function* () {
+    for (let i = 0; i < 50; i++) {
+      const session = SessionID.make(`ses_corpus_${i}`)
+      yield* addSession(db, session, i % 4 === 3 ? null : `Session ${i} parsing alpha${i % 6}`)
+      for (let k = 0; k < 3; k++) {
+        const turn = `c${i}_${k}`
+        yield* addMessages(
+          db,
+          session,
+          [user(`${turn}u`, `question ${k} of ses ${i} about indexing alpha${i % 6}`), assistant(`${turn}a`, [], false)],
+          k * 2 + 1,
+        )
+        yield* addPart(db, `${turn}a`, session, text(""))
+        for (let d = 1; d <= 5; d++) yield* editPart(db, `${turn}a`, `delta ${d} streaming`, false)
+        yield* rewrite(db, assistant(`${turn}a`, [], true))
+        if (i % 5 === 0 && k === 1) yield* editPart(db, `${turn}a`, "edited words gamma", reindex)
+      }
+    }
+    for (let i = 0; i < 50; i += 7) yield* db.delete(SessionMessageTable).where(eq(SessionMessageTable.id, id(`c${i}_0u`))).run()
+    for (let i = 0; i < 50; i += 11) yield* db.delete(SessionTable).where(eq(SessionTable.id, SessionID.make(`ses_corpus_${i}`))).run()
+  })
+
+/** Later writes: new completed replies in live sessions, a post-completion edit, a rename. */
+const seedB = (db: Db, reindex: boolean) =>
+  Effect.gen(function* () {
+    for (let i = 1; i <= 10; i++) {
+      const session = SessionID.make(`ses_corpus_${i}`)
+      yield* addMessages(db, session, [assistant(`b${i}a`, [], false)], 7)
+      yield* addPart(db, `b${i}a`, session, text("bravo streaming"))
+      yield* rewrite(db, assistant(`b${i}a`, [], true))
+      yield* editPart(db, `b${i}a`, "bravo edited", reindex)
+    }
+    yield* db.update(SessionTable).set({ title: "renamed gamma" }).where(eq(SessionTable.id, SessionID.make("ses_corpus_2"))).run()
+  })
+
+/** A fresh in-memory database per arm, since `database()` inserts a project and each arm needs its own. */
+const arm = <A, E>(body: (db: Db) => Effect.Effect<A, E>) =>
+  database().pipe(
+    Effect.flatMap(body),
+    Effect.provide(SqliteClient.layer({ filename: ":memory:", disableWAL: true })),
+  )
+
+describe("SessionSearchIndex corpus proofs", () => {
+  it.effect("gives the same hits as the Version 1 triggers and as a fresh build on a 50-session corpus", () =>
+    Effect.gen(function* () {
+      const old = yield* arm((db) =>
+        Effect.gen(function* () {
+          yield* index(db)
+          yield* swapPartTrigger(db)
+          yield* seedA(db, false)
+          yield* seedB(db, false)
+          return yield* hits(db)
+        }),
+      )
+      const incremental = yield* arm((db) =>
+        Effect.gen(function* () {
+          yield* index(db)
+          yield* seedA(db, true)
+          yield* seedB(db, true)
+          return yield* hits(db)
+        }),
+      )
+      const fresh = yield* arm((db) =>
+        Effect.gen(function* () {
+          yield* seedA(db, false)
+          yield* seedB(db, false)
+          yield* index(db)
+          return yield* hits(db)
+        }),
+      )
+
+      expect(incremental).toEqual(old)
+      expect(incremental).toEqual(fresh)
+      expect(incremental[Queries.indexOf("bravo")]).toHaveLength(10)
+      expect(incremental[Queries.indexOf("gamma")]?.length).toBeGreaterThan(0)
+    }),
+  )
+
+  it.effect("upgrades a Version 1 index to Version 2 in the background and matches a fresh build", () =>
+    Effect.gen(function* () {
+      const upgraded = yield* arm((db) =>
+        Effect.gen(function* () {
+          yield* index(db)
+          yield* swapPartTrigger(db)
+          yield* writeState(db, { version: 1, status: "done", phase: "messages" })
+          yield* seedA(db, false)
+          const ensured = yield* SessionSearchIndex.ensure(db)
+          expect(ensured).toMatchObject({ status: "ready", state: { version: 2, status: "building" } })
+          yield* SessionSearchIndex.buildChunk(db, { limit: 5 })
+          expect(yield* SessionSearchIndex.state(db)).toMatchObject({ version: 2, status: "building" })
+          // Writes arrive while the rebuild is partway through.
+          yield* seedB(db, true)
+          yield* build(db)
+          expect(yield* SessionSearchIndex.state(db)).toMatchObject({ version: 2, status: "done" })
+          return yield* hits(db)
+        }),
+      )
+      const fresh = yield* arm((db) =>
+        Effect.gen(function* () {
+          yield* seedA(db, false)
+          yield* seedB(db, false)
+          yield* index(db)
+          return yield* hits(db)
+        }),
+      )
+      expect(upgraded).toEqual(fresh)
+    }),
+  )
+})
