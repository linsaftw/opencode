+/**
+ * Reindexes a message after its session_part data was edited, which the part trigger does not watch. Like that trigger,
+ * it indexes only a finished assistant: a streaming message is indexed once, at completion.
+ */
+export const reindexPart = Effect.fn("SessionSearchIndex.reindexPart")(function* (
+  db: DatabaseService,
+  messageID: string,
+) {
+  const state = yield* readState(db).pipe(Effect.orDie)
+  if (!current(state)) return
+  const message = yield* db.get<{ session_id: string }>(
+    sql`SELECT session_id FROM session_message AS m WHERE m.id = ${messageID} AND m.type = 'assistant' AND json_valid(m.data) AND json_extract(m.data, '$.time.completed') IS NOT NULL`,
+  ).pipe(Effect.orDie)
+  if (!message) return
+  yield* reindexBatch(db, state.layout, [{ id: messageID, session: message.session_id }]).pipe(Effect.orDie)
+})
+
